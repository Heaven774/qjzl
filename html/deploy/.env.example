# ============================================
# 辣椒智慧农业 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并根据实际环境修改
# cp .env.example .env
# ============================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=qjzl
MYSQL_USER=qjzl
MYSQL_PASSWORD=qjzl123456

# ---------- DeepSeek API 配置 ----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------- 冷链监控页面(高德地图+云平台)配置 ----------
# 高德地图 Web JS API Key
# 申请地址: https://console.amap.com/
# 注意:需在高德控制台配置 JS API 的安全域名白名单(部署域名)
AMAP_KEY=your_amap_javascript_key_here

# 新物联云平台(NLECloud)账号密码
# 与 nlecloud-sdk 配套使用,用于拉取冷链车辆传感器真实数据
CLOUD_ACCOUNT=your_nlecloud_account
CLOUD_PASSWORD=your_nlecloud_password

# 云平台数据轮询间隔(毫秒),默认10秒
CLOUD_POLLING_INTERVAL=10000

# ---------- 端口映射（宿主机端口:容器端口） ----------
# Nginx Web 端口（对外暴露）
NGINX_PORT=80
# Node.js API 端口（如需外部调试可开启）
NODE_PORT_MAPPING=3000
# AI 建议服务端口
AI_PORT_MAPPING=4000
# 病虫害识别服务端口
DISEASE_PORT_MAPPING=5000
# 溯源服务端口
TRACE_PORT_MAPPING=5500
# RTSP 摄像头流服务端口
RTSP_PORT_MAPPING=8081
# MySQL 端口（如需外部工具连接可开启）
DB_PORT_MAPPING=3306