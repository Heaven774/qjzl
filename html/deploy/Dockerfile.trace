FROM rockylinux/rockylinux:10

RUN yum install -y -q python3 python3-pip python3-devel \
    && yum clean all \
    && rm -rf /var/cache/yum/*

WORKDIR /app

RUN pip3 install --no-cache-dir flask flask-cors qrcode Pillow pymysql \
    && rm -rf ~/.cache/pip

COPY trac/trac.py ./

EXPOSE 5500
CMD ["python3", "trac.py"]
