FROM rockylinux/rockylinux:10

RUN yum install -y -q python3 python3-pip python3-devel mesa-libGL \
    && yum clean all \
    && rm -rf /var/cache/yum/*

WORKDIR /app

RUN pip3 install --no-cache-dir \
    flask flask-cors opencv-python-headless numpy requests \
    && rm -rf ~/.cache/pip

COPY qjzl/rtsp_server.py ./

EXPOSE 8081
CMD ["python3", "rtsp_server.py"]
