<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#95A5"
    android:orientation="vertical">

    <!-- 顶部标题栏（包含返回按钮） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="8dp">

        <!-- 标题居中 -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="辣椒智慧溯源与管理"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvSystemStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_status_bg"
                android:gravity="center"
                android:text="🎛️ 系统状态: 运行中"
                android:textColor="#4CAF50"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvAutoMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_status_bg"
                android:gravity="center"
                android:text="🔄 模式: 手动"
                android:textColor="#2196F3"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>


    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:padding="8dp">

        <TextView
            android:id="@+id/btn_monitor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_selected"
            android:padding="4dp"
            android:text="环境监测"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />

        <TextView
            android:id="@+id/btn_control"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_selected"
            android:padding="4dp"
            android:text="设备控制"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />

        <TextView
            android:id="@+id/btn_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_selected"
            android:padding="4dp"
            android:text="AI分析"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />

        <TextView
            android:id="@+id/btn_disease"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_selected"
            android:padding="4dp"
            android:text="病虫害"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />

        <TextView
            android:id="@+id/btn_trace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_selected"
            android:padding="4dp"
            android:text="溯源"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />
    </LinearLayout>
</LinearLayout>